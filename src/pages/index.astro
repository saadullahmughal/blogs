---
import { getRelativeLocaleUrl } from "astro:i18n";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Socials from "@/components/Socials.astro";
import config from "@/config";
import { useTranslations } from "@/i18n";
import Layout from "@/layouts/Layout.astro";

const { socials } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const homePath = getRelativeLocaleUrl(locale, "");

const skills = {
  backend: ["NestJS", "FastAPI", "Express.js"],
  frontend: ["React", "Next.js"],
  cloud: ["Azure", "AWS", "GCP"],
  tools: ["Git & GitHub", "VS Code", "Zed Editor"],
};
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="pt-6 pb-6">
      <div>
        <h1 class="my-2 text-3xl font-bold sm:my-4 sm:text-4xl">
          M. Saadullah Zafar 👋
        </h1>
        <p class="text-lg font-medium text-accent">
          Software Engineer with an urge to improve the digital world
        </p>
      </div>

      <div class="mt-6 space-y-4 text-base leading-relaxed opacity-90">
        <p>
          Welcome! I am a Software Engineer with ~2 years of industry experience, specializing in backend development and full-stack web solutions. I graduated in Computer Science from <strong>UET Lahore</strong> and am currently pursuing my <strong>MSCS</strong> there.
        </p>
        <p>
          I have a deep interest in <strong>cybersecurity</strong> and a strong vision for positive digital transformation—especially spread awareness about technology, digital safety, and tech empowerment across the Islamic world and beyond.
        </p>
      </div>

      <!-- Skills Section -->
      <div class="mt-8 border-t border-border pt-6">
        <h2 class="text-xl font-semibold mb-3">Tech & Skills Overview</h2>
        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 text-sm">
          <div class="rounded-md border border-border p-3">
            <span class="font-semibold block mb-1">Backend Core:</span>
            <div class="flex flex-wrap gap-1.5">
              {skills.backend.map(item => (
                <span class="rounded bg-accent/10 px-2 py-0.5 text-xs font-medium text-accent">{item}</span>
              ))}
            </div>
          </div>
          <div class="rounded-md border border-border p-3">
            <span class="font-semibold block mb-1">Frontend:</span>
            <div class="flex flex-wrap gap-1.5">
              {skills.frontend.map(item => (
                <span class="rounded bg-accent/10 px-2 py-0.5 text-xs font-medium text-accent">{item}</span>
              ))}
            </div>
          </div>
          <div class="rounded-md border border-border p-3">
            <span class="font-semibold block mb-1">Cloud Platforms:</span>
            <div class="flex flex-wrap gap-1.5">
              {skills.cloud.map(item => (
                <span class="rounded bg-accent/10 px-2 py-0.5 text-xs font-medium text-accent">{item}</span>
              ))}
            </div>
          </div>
          <div class="rounded-md border border-border p-3">
            <span class="font-semibold block mb-1">Tools & Editors:</span>
            <div class="flex flex-wrap gap-1.5">
              {skills.tools.map(item => (
                <span class="rounded bg-accent/10 px-2 py-0.5 text-xs font-medium text-accent">{item}</span>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- Stay Tuned Notice -->
      <div class="mt-8 rounded-lg border border-accent/30 bg-accent/5 p-4 text-center">
        <h3 class="font-semibold text-lg text-accent">🚀 Content Coming Soon</h3>
        <p class="mt-1 text-sm opacity-90">
          I will be sharing technical articles, insights on software development, cybersecurity tips, and awareness guides here. <strong>Stay tuned!</strong>
        </p>
      </div>

      {
        socials.length > 0 && (
          <div class="mt-6 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0 font-medium">
              {t.home.socialLinks}:
            </div>
            <Socials />
          </div>
        )
      }
    </section>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>

